# Copy to config/.env and fill in. Never commit config/.env — it is in .gitignore for a reason.
#
# Values are read straight out of $_ENV. There is no config cache and no type coercion: a blank
# value and an absent one are the same thing, and everything arrives as a string.

# ── Identity ──────────────────────────────────────────────────────────────────────────────────

# Shown in the app shell, in every email, and in the browser tab. One place, so it can't drift.
APP_NAME="Keel"

# The app's own base URL, with scheme, no trailing slash. Every emailed link and every redirect is
# built from this, so it must be correct even in development.
APP_URL="http://localhost:8000"

# The apex your marketing site is served on. LEAVE BLANK for a single-host install — everything
# then routes to the app, which is what you want until you actually have a marketing site.
#
# Set both, and the split is: app.example.com -> the app, example.com -> marketing.
APP_DOMAIN=""

# 32 bytes, base64. Generate with: php scripts/generate-app-key.php
# Encrypts secrets at rest (TOTP seeds). Changing it makes anything already encrypted unreadable,
# which for two-factor means every enrolled user has to re-enroll.
APP_ENCRYPTION_KEY=""

# ── Database ──────────────────────────────────────────────────────────────────────────────────
#
# Leave DB_NAME blank for an application with no database. The front controller then never opens a
# connection and MySQL need not be installed.

DB_HOST="127.0.0.1"
DB_NAME=""
DB_USER=""
DB_PASS=""

# ── Mail ──────────────────────────────────────────────────────────────────────────────────────
#
# 'log' writes to storage/mail/YYYY-MM-DD.log instead of sending. That is the default on purpose:
# a fresh checkout that silently mails real people while someone tests a password reset is a worse
# failure than one that mails nobody.

MAIL_PROVIDER="log"
MAIL_FROM_EMAIL="noreply@example.com"
# What recipients see in their inbox. Not read from APP_NAME, because it is per-install.
MAIL_FROM_NAME="Keel"

# MAIL_PROVIDER="mailgun"
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_REGION="us"        # us | eu

# ── SMS (only for two-factor by text) ─────────────────────────────────────────────────────────

SMS_PROVIDER="log"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Billing (optional) ────────────────────────────────────────────────────────────────────────
#
# Leave STRIPE_SECRET_KEY blank and nothing in Keel\Billing is ever constructed. You also need
# `composer require stripe/stripe-php` — it is a suggestion, not a dependency.

STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
# From your Stripe webhook endpoint. Without it, signature verification fails closed and every
# webhook is rejected — which is the correct failure, but it does mean nothing arrives.
STRIPE_WEBHOOK_SECRET=""

# The one recurring price everything is sold at (price_...), plus display copy for the plans modal.
# Stripe is the authority on the amount actually charged; these two only draw a running total
# before the customer commits.
STRIPE_PRICE_ID=""
STRIPE_PRICE_LABEL="Subscription"
STRIPE_PRICE_CENTS="0"

# Days a past-due account keeps access while Stripe retries the card. 0 lapses on first failure.
SUBSCRIPTION_GRACE_DAYS="14"

# ── Public form defense ───────────────────────────────────────────────────────────────────────
#
# Cloudflare Turnstile, applied to the logged-out forms (sign-in, sign-up, password reset). Leave
# blank to skip it — the honeypot, timing check and rate limits still apply.
#
# The widget's allow-list on Cloudflare's side must include APP_DOMAIN, or it silently fails.

TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Comma-separated proxy IPs whose X-Forwarded-For may be trusted. Leave blank unless you actually
# run behind a proxy: trusting the header without one lets any client claim any IP, which defeats
# every per-IP rate limit at once.
TRUSTED_PROXIES=""
